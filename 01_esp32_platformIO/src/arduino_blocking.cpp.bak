#include <Arduino.h>
#include <DHT.h>

#define BUTTON_PIN 0
#define LED_PIN 2
#define DHT_PIN 4
#define DHT_TYPE DHT11
#define FLAME_TEST_PIN 32

DHT dht(DHT_PIN, DHT_TYPE);

bool stop_flag = false;
bool flame_flag = false;
int flame_count = 0;
int lastFlameState = HIGH;
int lastButtonState = HIGH;

volatile unsigned long t_press = 0;
volatile bool btn_event = false;
// 시작 시간 기록용 인터럽트 (순수 측정용)
void IRAM_ATTR test_isr() {
  if (t_press == 0) {
    t_press = micros();
    btn_event = true;
  }
}

void setup() {
    Serial.begin(115200);
    Serial.println("Initializing system (Arduino Blocking Version)..\n");

    pinMode(LED_PIN, OUTPUT);
    pinMode(BUTTON_PIN, INPUT_PULLUP);
    pinMode(FLAME_TEST_PIN, INPUT_PULLUP);
    dht.begin();

    attachInterrupt(digitalPinToInterrupt(BUTTON_PIN), test_isr, FALLING);
}

void loop() {
    // 1. 물리 버튼 입력 감지 (인터럽트 이벤트 기반으로 감지하여 delay 중 입력 누락 방지)
    if (btn_event) {
        if (!stop_flag) {
            stop_flag = true;
            Serial.println("emergency_stop");
            digitalWrite(LED_PIN, HIGH);

        } else {
            // 이미 정지 상태라면 인터럽트 입력을 무시하고 플래그 클리어
            t_press = 0;
            btn_event = false;
        }
    }

    // 2. 시리얼 포트 명령어 처리 (UI 연동)
    if (Serial.available()) {
        String command = Serial.readStringUntil('\n');
        command.trim();
        Serial.println(command); // 에코백
        if (command == "stop") {
            if (!stop_flag) {
                stop_flag = true;
                Serial.println("emergency_stop");
                digitalWrite(LED_PIN, HIGH);
                t_press = 0;
                btn_event = false;
            }
        } else if (command == "recover") {
            if (stop_flag) {
                stop_flag = false;
                digitalWrite(LED_PIN, LOW);
                Serial.println("system_recovered");
                t_press = 0;
                btn_event = false;
            }
        }
    }

    // 3. 화재 감지 핀 감지 및 카운트 동작
    if (!stop_flag) {
        int FlameState = digitalRead(FLAME_TEST_PIN);
        if (lastFlameState == HIGH && FlameState == LOW) {
            flame_flag = true;
            Serial.println("flame");
        }
        lastFlameState = FlameState;

        if (flame_flag) {
            flame_count++;
            if (flame_count > 50) {
                flame_flag = false;
                flame_count = 0;
                Serial.println("noflame");
            }
        }
    }

    // 4. 온습도 센서 읽기 및 2초 블로킹 지연 (delay)
    // 이 delay()로 인해 대기하는 동안 버튼 입력, 시리얼 수신, 화재 감지가 모두 멈추게 됩니다.
    if (!stop_flag && !flame_flag) {
        float humidity = dht.readHumidity();
        float temperature = dht.readTemperature();

        if (isnan(humidity) || isnan(temperature)) {
            Serial.println("DHT11 failed");
        } else {
            Serial.printf("%.1f,%.1f\n", humidity, temperature);
        }
        
        // 온습도 센서 권장 측정 주기인 2초 동안 delay를 실행하여 CPU를 블로킹합니다.
        // 이 동안에는 물리 버튼을 누르거나 UI에서 정지 버튼을 눌러도 반응하지 않습니다.
        Serial.println("[Arduino] Delaying 2000ms...");

        UBaseType_t stack_margin = uxTaskGetStackHighWaterMark(NULL); 
        uint32_t free_heap = ESP.getFreeHeap();
        Serial.printf("[DHT Task] Stack Margin: %d bytes | System Free Heap: %d bytes\n", stack_margin, free_heap);
        
        delay(2000); 
    } else {
        // 정지 상태 또는 화재 상태일 때는 루프 속도를 제어하기 위해 짧은 딜레이만 수행합니다.

        // 완료 시간 기록 및 지연 시간 계산
        if(btn_event) {
            unsigned long t_led = micros();
            float latency_ms = (t_led - t_press) / 1000.0;
            Serial.printf("[Arduino] Button Latency: %.3f ms\n", latency_ms);
            t_press = 0;
            btn_event = false;

            UBaseType_t stack_margin = uxTaskGetStackHighWaterMark(NULL); 
            uint32_t free_heap = ESP.getFreeHeap();
            Serial.printf("[Arduino stop] Stack Margin: %d bytes | System Free Heap: %d bytes\n", stack_margin, free_heap);
        }

        delay(200); 
    }
}
